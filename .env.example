# Copy to .env (git-ignored) and replace every value. docker compose reads .env automatically.

# Postgres superuser (used only by the init script that creates per-service databases)
POSTGRES_USER=zerosum_admin
POSTGRES_PASSWORD=change-me

# One database + one login role per service (database-per-service, single container)
ACCOUNT_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me
LEDGER_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
